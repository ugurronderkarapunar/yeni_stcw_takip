# --- Zorunlu ---
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
GEMINI_API_KEY=your_google_ai_studio_key
# gemini-1.5-flash emekliye ayrildi; guncel ucretsiz Flash modeli:
GEMINI_MODEL=gemini-2.5-flash

# --- E-posta (Gmail Uygulama Sifresi, 16 hane, bosluksuz) ---
SMTP_EMAIL=ornek@gmail.com
SMTP_PASSWORD=abcdefghijklmnop
NOTIFY_DEFAULT_EMAIL=filo-yoneticisi@ornek.com

# --- WhatsApp (opsiyonel) ---
WHATSAPP_PROVIDER=greenapi            # greenapi | twilio
WHATSAPP_API_KEY=                     # greenapi: apiTokenInstance | twilio: ACCOUNT_SID:AUTH_TOKEN
GREEN_API_INSTANCE_ID=                # sadece greenapi
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
NOTIFY_DEFAULT_PHONE=905551234567     # basinda + olmadan, ulke kodu ile

# --- Uygulama ---
APP_PASSWORD=                         # bos birakirsaniz panel herkese acik olur
WARNING_DAYS=15
SCHEDULER_HOUR=9
SCHEDULER_TZ=Europe/Istanbul
